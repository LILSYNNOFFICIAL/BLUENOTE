# ============================================================================
# BLUENOTE — ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================
# SECURITY POLICY:
# Never commit plaintext API keys to git. Store keys in:
# 1. Local development: .env.local (gitignored)
# 2. GitHub Pages & Android CI/CD: GitHub Repository Settings -> Secrets and variables -> Actions
#
# BlueNote's AI Studio also includes Free Keyless AI APIs + 100% On-Device WebGL/Canvas/WebAudio
# synthesis engines so Songs, Images, Video, OCR, and Brain Dump work even with zero keys set.

# Optional Free Google Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# Optional Free Pollinations / HuggingFace Token for extended cloud image/audio models
VITE_POLLINATIONS_API_KEY=
VITE_HF_TOKEN=

# Application URL (GitHub Pages deployment URL)
APP_URL="https://lilsynnofficial.github.io/BLUENOTE/"
